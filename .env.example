PORT=3001

# AI_PROVIDER can be: openai, deepseek, glm, custom
AI_PROVIDER=openai

# Use json_object for OpenAI-compatible JSON mode. Set to none if a custom provider rejects response_format.
AI_JSON_RESPONSE_FORMAT=json_object

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_URL=https://api.openai.com/v1/chat/completions

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions

# GLM / Zhipu BigModel
GLM_API_KEY=
GLM_MODEL=glm-5.1
GLM_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions

# Backward-compatible fallback
TEXT_GENERATION_API_KEY=
TEXT_GENERATION_MODEL=
TEXT_GENERATION_API_URL=
TEXT_GENERATION_JSON_RESPONSE_FORMAT=
